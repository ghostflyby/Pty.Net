<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Ghostflyby.Pty</RootNamespace>
        <!-- The shipped package/assembly name: the repo is Pty.Net, the NuGet id is
             vendor-prefixed (Ghostflyby.Pty) to avoid colliding with the unlisted
             Pty.Net package on nuget.org. -->
        <AssemblyName>Ghostflyby.Pty</AssemblyName>
        <PackageId>Ghostflyby.Pty</PackageId>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- No reflection / dynamic loading / dynamic linking: declare AOT compat so the
             AOT analyzers run at build time (IL20xx diagnostics) instead of needing a
             full AOT publish smoke test. -->
        <IsAotCompatible>true</IsAotCompatible>

        <!-- Documentation is part of the public contract: always emit the XML doc file.
             Every warning is a build error (TreatWarningsAsErrors), so a missing or
             malformed doc comment, a dangling cref, a missing <param> tag, or any other
             new warning from a future SDK fails the build. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Platform symbol used by #if in NativeMethods.Unix.cs / PtyProcess.Start.Unix.cs.
             The SDK may define OSX/LINUX automatically from the build host, but be explicit.
             Windows needs no define: the Windows files are compiled via file globs below. -->
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);OSX</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);LINUX</DefineConstants>

        <!-- CsWin32 build-task mode makes it emit [LibraryImport] externs (the plain
             source-generator mode emits [DllImport], which would trip the IL20xx
             diagnostics under IsAotCompatible). Windows-only. -->
        <CsWin32RunAsBuildTask Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</CsWin32RunAsBuildTask>
    </PropertyGroup>

    <!-- Platform split by file globs instead of inline #if: PtyProcess.cs and PtyReaper.cs
         are platform-free and reach platform code through partial methods; each platform
         half lives in a .Windows.cs / .Unix.cs file compiled only on its platform.
         The .Unix.cs set also carries the macOS/Linux (#if OSX/LINUX) differences. -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <Compile Remove="**/*.Unix.cs" />
        <Compile Update="PtyProcess.Start.Windows.cs;PtyStream.Windows.cs;WindowsPty.Windows.cs" />
    </ItemGroup>
    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
        <Compile Remove="**/*.Windows.cs" />
        <Compile Update="NativeMethods.Unix.cs;PtyIoEngine.Unix.cs;PtyProcess.Start.Unix.cs;PtyStream.Unix.cs" />
    </ItemGroup>

    <!-- Windows-only: CsWin32 source-generates the ConPTY interop (CreatePseudoConsole +
         CreateProcessW + attribute list) under Windows.Win32.PInvoke. PrivateAssets
         keeps the generator package out of consumers. -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298" PrivateAssets="all" />
    </ItemGroup>

    <!-- The test suite reads internal state (pipe handles, debug trace) directly. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Pty.Net.Tests" />
    </ItemGroup>

</Project>
