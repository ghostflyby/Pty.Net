<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Ghostflyby.Pty</RootNamespace>
        <!-- The shipped package/assembly name: the repo is Pty.Net, the NuGet id is
             vendor-prefixed (Ghostflyby.Pty) to avoid colliding with the unlisted
             Pty.Net package on nuget.org. -->
        <AssemblyName>Ghostflyby.Pty</AssemblyName>
        <PackageId>Ghostflyby.Pty</PackageId>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- No reflection / dynamic loading / dynamic linking: declare AOT compat so the
             AOT analyzers run at build time (IL20xx diagnostics) instead of needing a
             full AOT publish smoke test. -->
        <IsAotCompatible>true</IsAotCompatible>

        <!-- Platform symbol used by #if in NativeMethods.cs / PtyProcess.cs. The SDK
             may define OSX/LINUX automatically from the build host, but be explicit. -->
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);OSX</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>

</Project>
