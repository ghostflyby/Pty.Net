<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ghostflyby.Pty</RootNamespace>
    <!-- The shipped package/assembly name: the repo is Pty.Net, the NuGet id is
         vendor-prefixed (Ghostflyby.Pty) to avoid colliding with the unlisted
         Pty.Net package on nuget.org. -->
    <AssemblyName>Ghostflyby.Pty</AssemblyName>
    <PackageId>Ghostflyby.Pty</PackageId>
    <!-- NuGet package metadata. Description and tags mirror the GitHub repo
         description and topics — keep them in sync. No <Version> here on purpose:
         the version is derived from the git tag at publish time (vX.Y.Z → X.Y.Z),
         so the tag is the single source of truth and this file never drifts. -->
    <Authors>ghostflyby</Authors>
    <Description>The multi-platform pty wrapper in pure C# with P/Invoke: drive interactive shells with a real terminal on Windows, macOS, and Linux.</Description>
    <!-- SPDX expression: nuget.org renders the Apache-2.0 badge from it. The license
         text itself lives at the repo root (LICENSE). -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ghostflyby/Pty.Net</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ghostflyby/Pty.Net</PackageProjectUrl>
    <PackageTags>pty;pseudo-terminal;conpty;csharp;dotnet;dotnet-library</PackageTags>

    <!-- Symbols: the single source set compiles on every OS, so each platform build job
         emits byte-identical IL and PDBs — one snupkg, no per-OS artifact merge.
         ContinuousIntegrationBuild keeps the compilation deterministic
         (normalized paths), which SourceLink requires. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- No reflection / dynamic loading / dynamic linking: declare AOT compat so the
         AOT analyzers run at build time (IL20xx diagnostics) instead of needing a
         full AOT publish smoke test. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Documentation is part of the public contract: always emit the XML doc file.
         Every warning is a build error (TreatWarningsAsErrors), so a missing or
         malformed doc comment, a dangling cref, a missing <param> tag, or any other
         new warning from a future SDK fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Symbols: every OS build job compiles the SAME single source set (all platform
         halves, no per-OS file globs), so the three platform jobs produce byte-identical
         IL and one pack suffices. CsWin32 must therefore run on every host: build-task
         mode is required cross-platform anyway (the plain source-generator mode emits
         [DllImport] instead of [LibraryImport] and does not parse the # comments in
         NativeMethods.txt). -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
  </PropertyGroup>

  <!-- CsWin32 source-generates the ConPTY interop (CreatePseudoConsole + CreateProcessW
       + attribute list) under Windows.Win32.PInvoke. Runs on every build host; the
       generated [LibraryImport] stubs are lazily bound, so they compile and AOT-verify
       fine on any OS and only resolve when actually called on Windows. PrivateAssets
       keeps the generator package out of consumers. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all"/>
  </ItemGroup>

  <!-- The test suite reads internal state (pipe handles, debug trace) directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pty.Net.Tests"/>
  </ItemGroup>

  <!-- Ship the README inside the package: nuget.org renders it on the package page
       (PackageReadmeFile above). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Link="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <!-- Public API contract: PublicApiAnalyzers fails the build whenever a public symbol
       is missing from PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt or the shipped
       surface changes incompatibly. The baseline files are explicit here even though
       the package also wires them up automatically. PrivateAssets keeps the analyzer
       and its rules out of consumers. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all"/>
    <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
    <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
  </ItemGroup>

</Project>
