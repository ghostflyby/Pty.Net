{
  // Pins the SDK so local builds and CI run the same toolchain. latestFeature
  // accepts any installed 10.0.x feature band at or above this floor, so the
  // rolling sdk:10.0 container images and the runners' setup-dotnet 10.0.x both
  // satisfy it without a bump on every patch release.
  "sdk": {
    "version": "10.0.100",
    "rollForward": "latestFeature",
    "allowPrerelease": false
  },
  // Opts dotnet test into its .NET 10 MTP mode, which is how the xunit.v3 test
  // project runs (the legacy VSTest mode refuses MTP projects on the .NET 10 SDK).
  "test": {
    "runner": "Microsoft.Testing.Platform"
  }
}
