{
  // Pins the SDK so local builds and CI run the same toolchain. Major accepts
  // any installed SDK at or above this floor (closest match, crossing feature
  // bands and minors), so the rolling sdk:10.0 container images and any newer
  // runner or local install satisfy it without a bump.
  "sdk": {
    "version": "10.0.100",
    "rollForward": "Major",
    "allowPrerelease": false
  },
  // Opts dotnet test into its .NET 10 MTP mode, which is how the xunit.v3 test
  // project runs (the legacy VSTest mode refuses MTP projects on the .NET 10 SDK).
  "test": {
    "runner": "Microsoft.Testing.Platform"
  }
}
